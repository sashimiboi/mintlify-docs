            "pages": [
              "features/query-engine",
              "features/ai-engine",
              "features/analytics",
              "features/mcp-studio",
              "features/governance"
            ]
          },
          {
            "group": "Data Connectors",
            "pages": [
              "connectors/overview",
              "connectors/postgresql",
              "connectors/mysql",
              "connectors/clickhouse",
              "connectors/bigquery",
              "connectors/snowflake",
              "connectors/mongodb"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/mcp"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/mfa"
            ]
          }
        ]
      },
